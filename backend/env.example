# =============================================================================
# Backend environment variables – copy to .env and fill in real values.
# Variables marked REQUIRED have no default; the app will not start without them.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT  (REQUIRED)
# Must be at least 32 characters.  Generate with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=<REQUIRED – generate a strong random secret>

# JWT token lifetime in milliseconds (default: 1 800 000 = 30 min)
JWT_EXPIRATION_MS=1800000
JWT_ISSUER=realestate-guide
JWT_AUDIENCE=realestate-clients

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/realestate
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update

# -----------------------------------------------------------------------------
# CORS / allowed origins (comma-separated)
# In production set this to your real domain(s) only.
# -----------------------------------------------------------------------------
APP_SECURITY_ALLOWED_ORIGINS=https://realestate-guide.in,https://www.realestate-guide.in

# Login limiter only (local development default: disabled; production defaults to enabled)
LOGIN_RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW=1m

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_ROOT=uploads

# AWS S3 (only needed when APP_STORAGE_TYPE=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PROJECT_DOCS_BUCKET=
AWS_S3_CHAT_DOCS_BUCKET=
AWS_S3_KYC_DOCS_BUCKET=
AWS_S3_KYC_KMS_KEY_ID=

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Mail (Brevo SMTP)
# -----------------------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@realestate-guide.in
OTP_EXPIRY_MINUTES=10

# -----------------------------------------------------------------------------
# Firebase (optional – for push notifications)
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
